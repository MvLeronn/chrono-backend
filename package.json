{
  "name": "chrono-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "yarn typecheck",
    "format": "prettier --write . && prisma format",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed:admin": "tsx src/seeds/admin.ts",
    "password:reset": "tsx src/seeds/reset-password.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "5",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "24",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.9.9",
    "prisma": "7",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "5"
  }
}
